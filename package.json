{
  "name": "fortress-jwt-rbac",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "description": "Full-Stack Zero-Trust Access & Approval Vault (Node.js, Express, TypeScript & React/Vite) featuring In-Memory JWT, HttpOnly Rotating Refresh Cookies, Bcrypt, granular RBAC, and WCAG 2.1 AA accessible UI with Tailwind CSS, shadcn/ui, and Framer Motion.",
  "author": "José Guilherme <https://github.com/JzGuilherme>",
  "license": "MIT",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "dev:server": "node --import tsx server/src/index.ts",
    "dev:client": "vite",
    "test": "node --import tsx --test server/tests/authAndRbac.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.17",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
