# Server & Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Zero-Trust JWT & Refresh Cookie Secrets (NEVER commit real production secrets)
JWT_ACCESS_SECRET=your_256_bit_in_memory_access_secret_here
JWT_REFRESH_SECRET=your_256_bit_httponly_cookie_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Bcrypt Password Hashing Cost
BCRYPT_SALT_ROUNDS=12

# SQL Database Configuration (SQLite in-memory/file or SQL Server / MySQL compatible)
DB_STORAGE_PATH=:memory:
